# `db-podcast auth` writes the first two to `.env` for you. `.env` is git-ignored.

# The app key of your Dropbox app (https://www.dropbox.com/developers/apps).
DB_PODCAST_APP_KEY=
# Long-lived access to your Dropbox for that app. Treat it like a password.
DB_PODCAST_REFRESH_TOKEN=

# fetchit's library, or a folder with one sub-folder per podcast. Optional;
# defaults to ~/fetchit.
# DB_PODCAST_LIBRARY=~/fetchit

# The feeds to publish, comma-separated, by their name in fetchit.json.
# Optional; all of them when empty.
# DB_PODCAST_FEEDS=Bureau Buitenland, Mes premières Belles Histoires

# The Dropbox folder the library is mirrored to. Optional; defaults to
# /podcasts, which for an "App folder" app is Apps/<app name>/podcasts.
# DB_PODCAST_REMOTE_ROOT=/podcasts
